#!/usr/bin/env bash
# ScrumIA — turns a ticket's scope and risk into an execution decision.
# Callers act on `instruction`; they do not re-read the matrix themselves.

set -uo pipefail

CONFIG="${SCRUMIA_CONFIG:-.scrumia/config.yaml}"
MODULE_ROOT=$(cd -- "$(dirname -- "$0")/.." && pwd)

# What this tool stands in with where no layer carries a value. Named once so the lookups
# below and the warning that reports a substitution cannot drift apart. The grid itself is
# absent from this list on purpose: it has no stand-in (`execution-policy` AC-22).
FALLBACK_UNLABELED=sonnet
FALLBACK_UNRATED_RISK=medium
FALLBACK_SCOPE_PREFIX="scope/"
FALLBACK_RISK_PREFIX="risk/"

die() { printf '{"ok":false,"error":%s}\n' "$(jq -Rn --arg m "$1" '$m')"; exit 1; }
warn() { echo "scrumia-pick-model: $1" >&2; }

usage() {
  cat >&2 <<'EOF'
scrumia-pick-model <issue-number>
scrumia-pick-model --scope S|M|L|XL [--risk low|medium|high|critical]

Resolves this module's execution policy through the composition's settings cascade —
`settings:`, then this module's `params:`, then .scrumia/config.local.yaml — and returns
the model to run a ticket on, or, for oversized work, an instruction to split first.
Answers nothing when the policy cannot be resolved.
EOF
  exit 2
}

load_config() {
  [ -f "$CONFIG" ] || die "no $CONFIG — run /scrumia-core:scrumia-init first"
  if command -v yq >/dev/null 2>&1; then
    CFG=$(yq -o=json '.' "$CONFIG" 2>/dev/null)
  elif python3 -c 'import yaml' >/dev/null 2>&1; then
    CFG=$(python3 -c 'import sys,yaml,json; json.dump(yaml.safe_load(open(sys.argv[1])) or {}, sys.stdout)' "$CONFIG" 2>/dev/null)
  else
    die "need yq or python3+PyYAML to read $CONFIG"
  fi
  [ -n "${CFG:-}" ] || die "$CONFIG is empty or not valid YAML"
  # `project.repo` names the repository, not this module's configuration, so it is read
  # here; everything the policy itself needs comes through the cascade below.
  REPO=$(jq -r '.project.repo // empty' <<<"$CFG")
}

# The key this module's `params:` sit under. The project's own declaration decides it —
# `local:`, `shared:` and a fork's marketplace are all legal sources (BR-13), and none of
# them is predictable from this module's manifest — so the config is asked first and the
# manifest is only the fallback for a project that declares no module of this name.
# Echoes nothing and returns non-zero when neither answers; a `die` here would print its
# JSON into the caller's variable and exit the subshell only.
module_key() {
  local manifest="$MODULE_ROOT/.claude-plugin/plugin.json" name src declared
  name=$(jq -r '.name // ""' "$manifest" 2>/dev/null)
  [ -n "$name" ] || name=$(basename "$MODULE_ROOT")
  [ -n "$name" ] || return 1

  declared=$(jq -r --arg n "$name" '(.modules // {}) | keys[]? | select(sub("^.*:"; "") == $n)' \
    <<<"$CFG" 2>/dev/null | head -1)
  [ -n "$declared" ] && { printf '%s\n' "$declared"; return 0; }

  src=$(jq -r '(.repository // .homepage // "")
    | sub("^[a-z+]+://[^/]+/"; "") | sub("\\.git$"; "") | sub("/$"; "")' "$manifest" 2>/dev/null)
  [ -n "$src" ] || return 1
  printf '%s:%s\n' "$src" "$name"
}

# The policy is resolved through the three layers rather than read out of `settings:`,
# which would see layer 1 only and silently discard the per-machine layer
# (`modular-composition` BR-15). Every failure below stops the tool: a model name computed
# from built-in defaults is indistinguishable from one computed from the grid, so it is the
# one wrong answer nobody has reason to check (`execution-policy` AC-22).
load_policy() {
  local key out
  if ! key=$(module_key); then
    # Layer 2 is the only layer keyed by a module, so an unnameable module loses that
    # layer and keeps the other two — degraded, exactly as the resolver itself degrades.
    warn "cannot derive this module's key from $CONFIG or its own manifest — resolving without its params: layer"
    key=""
  fi

  command -v scrumia-extends >/dev/null 2>&1 ||
    die "scrumia-extends not found — enable scrumia-core and restart the session. No model is chosen: reading $CONFIG directly would resolve one layer of three and answer with a model nobody configured"
  out=$(scrumia-extends --settings "$key") ||
    die "scrumia-extends --settings $key failed — the execution policy is unresolved, and no model is chosen. Run scrumia-extends --settings $key by hand to see what it reports, or scrumia-extends --check for an unmet dependency"
  jq -e 'type == "object"' >/dev/null 2>&1 <<<"$out" ||
    die "scrumia-extends --settings $key returned no object — the execution policy is unresolved, and no model is chosen. Check that $CONFIG parses, then run scrumia-extends --settings $key by hand"

  # ADR-0021 moves what `settings.team.execution` held into this module's own `params:`,
  # so the resolved block carries `execution` at its top level. The retired nest is still
  # read while projects migrate, and the two are *merged* rather than chosen between:
  # picking one whole shape would drop every key the other still carries onto this
  # script's own literals — a project that has migrated its matrix but not its label
  # prefixes would match no ticket and route every one of them to `unlabeled`. The new
  # shape wins key by key.
  # `with_entries` is load-bearing — jq's `*` propagates an explicit null, so a key
  # written bare mid-migration would overwrite the value the base layer still carries.
  # It filters the top level only: a null nested deeper, inside `labels`, still wins the
  # merge and erases the base layer's value. #342 owns that; the warning below at least
  # names every literal that ends up standing in.
  EXEC=$(jq -c '(.team.execution // {})
                * ((.execution // {}) | with_entries(select(.value != null)))' <<<"$out")

  # The grid is the policy. Its absence is a broken installation, not a hole in a table
  # (`execution-policy` AC-22 vs AC-10), and answering it from this script's literals
  # would run every ticket in the project on a default nobody chose.
  jq -e '(.matrix | type) == "object" and (.matrix | length) > 0' >/dev/null 2>&1 <<<"$EXEC" ||
    die "no execution grid in the resolved settings for ${key:-this module} — looked for 'execution.matrix' and the retired 'team.execution.matrix', and no layer of the cascade carries either. Run scrumia-team-setup; no model is chosen, because one taken from this tool's defaults would read like one taken from the grid"

  # Beyond the grid the tool carries literals, and a literal standing in for a value
  # nobody configured is the same failure one size smaller. Not fatal — the grid still
  # decides every labelled ticket — but never silent. Each key is tested for a *value*,
  # not for its presence: a project migrating one key at a time writes them bare, and a
  # key that exists holding null is a key this tool is about to stand in for.
  local fell_back
  fell_back=$(jq -r --arg u "$FALLBACK_UNLABELED" --arg r "$FALLBACK_UNRATED_RISK" \
                    --arg sp "$FALLBACK_SCOPE_PREFIX" --arg rp "$FALLBACK_RISK_PREFIX" '
    [ (if .unlabeled != null then empty else "unlabeled=" + $u end)
    , (if .unrated_risk != null then empty else "unrated_risk=" + $r end)
    , (if (.labels | type) == "object" and .labels.scope_prefix != null then empty
       else "labels.scope_prefix=" + $sp end)
    , (if (.labels | type) == "object" and .labels.risk_prefix != null then empty
       else "labels.risk_prefix=" + $rp end) ]
    | join(", ")' <<<"$EXEC")
  [ -z "$fell_back" ] ||
    warn "no layer carries $fell_back — this tool's own literals stand in for them; configure them under execution"
}

labels_of_issue() {
  local issue="$1" out
  [ -n "$REPO" ] || die "project.repo missing from $CONFIG"
  out=$(gh issue view "$issue" --repo "$REPO" --json labels,title 2>&1) \
    || die "issue #$issue unreadable: $out"
  echo "$out"
}

ISSUE="" SCOPE="" RISK="" TITLE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --scope) SCOPE="${2:-}"; shift 2 ;;
    --risk)  RISK="${2:-}"; shift 2 ;;
    -h|--help) usage ;;
    [0-9]*)  ISSUE="$1"; shift ;;
    *) usage ;;
  esac
done
[ -n "$ISSUE" ] || [ -n "$SCOPE" ] || usage

command -v jq >/dev/null 2>&1 || die "jq not found"
load_config
load_policy

SCOPE_PREFIX=$(jq -r --arg d "$FALLBACK_SCOPE_PREFIX" '.labels.scope_prefix // $d' <<<"$EXEC")
RISK_PREFIX=$(jq -r --arg d "$FALLBACK_RISK_PREFIX" '.labels.risk_prefix // $d' <<<"$EXEC")

# A project that already labels its tickets keeps its own words; the matrix
# speaks S/M/L/XL and low/high, so the vocabularies are mapped, not imposed.
alias_of() {
  jq -r --arg kind "$1" --arg v "$2" \
    '.labels[$kind + "_aliases"][$v] // $v' <<<"$EXEC"
}

if [ -n "$ISSUE" ]; then
  command -v gh >/dev/null 2>&1 || die "gh not found — install the GitHub CLI"
  issue_json=$(labels_of_issue "$ISSUE")
  TITLE=$(jq -r '.title // ""' <<<"$issue_json")
  SCOPE=$(jq -r --arg p "$SCOPE_PREFIX" '[.labels[].name | select(startswith($p))][0] // "" | ltrimstr($p)' <<<"$issue_json")
  RISK=$(jq -r --arg p "$RISK_PREFIX" '[.labels[].name | select(startswith($p))][0] // "" | ltrimstr($p)' <<<"$issue_json")
fi

[ -n "$SCOPE" ] && SCOPE=$(alias_of scope "$SCOPE")
[ -n "$RISK" ] && RISK=$(alias_of risk "$RISK")

DEFAULT_RISK=$(jq -r --arg d "$FALLBACK_UNRATED_RISK" '.unrated_risk // $d' <<<"$EXEC")
UNLABELED=$(jq -r --arg d "$FALLBACK_UNLABELED" '.unlabeled // $d' <<<"$EXEC")

SCOPE_RATED=true; RISK_RATED=true
[ -n "$SCOPE" ] || { SCOPE_RATED=false; }
[ -n "$RISK" ] || { RISK_RATED=false; RISK="$DEFAULT_RISK"; }

emit() {
  jq -n --arg issue "$ISSUE" --arg title "$TITLE" --arg scope "$SCOPE" --arg risk "$RISK" \
        --arg decision "$1" --arg model "$2" --arg instruction "$3" --arg because "$4" \
        --argjson scope_rated "$SCOPE_RATED" --argjson risk_rated "$RISK_RATED" '
    {ok: true,
     issue: (if $issue == "" then null else ($issue|tonumber) end),
     title: (if $title == "" then null else $title end),
     scope: (if $scope == "" then null else $scope end),
     risk: $risk,
     scope_rated: $scope_rated,
     risk_rated: $risk_rated,
     decision: $decision,
     model: $model,
     instruction: $instruction,
     because: $because}'
}

# A deviation happens after the policy speaks, so the answer carries the obligation
# to state a reason, never the reason.
DEVIATION_NOTE=" Running on anything else is a deviation: record it on the ticket — what the policy chose, what ran, and why — before the work starts."

# No scope label means the ticket was never refined; guessing one would invent
# an estimate nobody made.
if [ "$SCOPE_RATED" = false ]; then
  warn "issue has no ${SCOPE_PREFIX}* label — falling back to execution.unlabeled"
  emit "model" "$UNLABELED" \
    "Run on $UNLABELED, and say in the PR that this ticket carried no ${SCOPE_PREFIX}* label. Ask for refinement rather than assuming a size.$DEVIATION_NOTE" \
    "no ${SCOPE_PREFIX}* label -> execution.unlabeled"
  exit 0
fi

CELL=$(jq -r --arg s "$SCOPE" --arg r "$RISK" \
  '.matrix[$s][$r] // empty' <<<"$EXEC")

if [ -z "$CELL" ]; then
  warn "no matrix cell for scope=$SCOPE risk=$RISK — falling back to execution.unlabeled"
  emit "model" "$UNLABELED" \
    "Run on $UNLABELED. The matrix in $CONFIG has no cell for scope=$SCOPE risk=$RISK — report this gap.$DEVIATION_NOTE" \
    "matrix[$SCOPE][$RISK] undefined -> execution.unlabeled"
  exit 0
fi

RISK_NOTE=""
[ "$RISK_RATED" = false ] && RISK_NOTE=" Risk was not rated, so ${RISK_PREFIX}${RISK} was assumed — flag this if the ticket looks riskier."

# split_or_<model>: prefer splitting, but oversized is not a dead end. The
# caller judges feasibility, which is why the fallback travels with the verdict.
case "$CELL" in
  split_or_*)
    FALLBACK=${CELL#split_or_}
    emit "split_or_model" "$FALLBACK" \
      "First try to split this ticket into independently executable tickets. If — and only if — the work is genuinely indivisible, execute it on $FALLBACK and record the refused split on the ticket, with the reason it could not be divided. Do not split into tickets that cannot ship on their own.$RISK_NOTE" \
      "scope=$SCOPE risk=$RISK -> $CELL"
    ;;
  split)
    emit "split" "" \
      "Split this ticket before executing it. This cell allows no fallback model — return it to refinement.$RISK_NOTE Executing it anyway is a deviation, whatever it runs on: record it on the ticket — that the policy answered split, what ran, and why — before the work starts." \
      "scope=$SCOPE risk=$RISK -> split"
    ;;
  *)
    emit "model" "$CELL" \
      "Execute this ticket on $CELL.$RISK_NOTE$DEVIATION_NOTE" \
      "scope=$SCOPE risk=$RISK -> $CELL"
    ;;
esac
