#!/usr/bin/env bash
# ScrumIA — builds, prints and checks the composed assemblies.
#
# build : reads .scrumia/config.yaml, asks each module named in extends to describe
#         itself, and writes .scrumia/assemblies/ — one file per provided action.
# load  : prints a built assembly, resolving each module+path pair to a real path.
#         It computes nothing: stale inputs make it refuse, never recompute.
# check : rebuilds into a temp dir and diffs. The CI gate.

# -f because several unquoted splits below are over config text, never a path.
set -fuo pipefail

CONFIG="${SCRUMIA_CONFIG:-.scrumia/config.yaml}"
OUT="${SCRUMIA_ASSEMBLIES:-.scrumia/assemblies}"
SELF=$(basename "$0")
HERE=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
VOCAB="$HERE/data/actions.json"
PROGRAM="$HERE/data/assemble.jq"

die() { echo "$SELF: $1" >&2; exit 1; }
note() { echo "$SELF: $1" >&2; }

usage() {
  cat >&2 <<'EOF'
scrumia-assemble build            # write .scrumia/assemblies/ from .scrumia/config.yaml
scrumia-assemble load <action>    # print one built assembly, paths resolved
scrumia-assemble check            # rebuild into a temp dir and diff; exit 1 on drift

Reads $SCRUMIA_CONFIG (default .scrumia/config.yaml). Writes only under
$SCRUMIA_ASSEMBLIES (default .scrumia/assemblies), and `load` and `check` write nothing.

A module is asked to describe itself by running the `<module>-manifest` name it publishes
on PATH. $SCRUMIA_MODULE_DIR overrides that with a directory holding <module>/ checkouts —
for this repository and for CI, where no harness puts a plugin's bin/ on PATH.
EOF
  exit 2
}

command -v jq >/dev/null 2>&1 || die "jq not found"
[ -f "$VOCAB" ] || die "missing action vocabulary at $VOCAB"
[ -f "$PROGRAM" ] || die "missing render program at $PROGRAM"

# Same loader as scrumia-board, scrumia-pick-model and compose-status.sh: one of the two
# YAML readers the machine already has, never a third dependency.
load_config() {
  [ -f "$CONFIG" ] || die "no $CONFIG — run /scrumia-core:scrumia-init first"
  if command -v yq >/dev/null 2>&1; then
    CFG=$(yq -o=json '.' "$CONFIG" 2>/dev/null)
  elif python3 -c 'import yaml' >/dev/null 2>&1; then
    CFG=$(python3 -c 'import sys,yaml,json; json.dump(yaml.safe_load(open(sys.argv[1])) or {}, sys.stdout)' "$CONFIG" 2>/dev/null)
  else
    die "need yq or python3+PyYAML to read $CONFIG"
  fi
  [ -n "${CFG:-}" ] || die "$CONFIG is empty or not valid YAML"

  # A number nobody could compute must not be printed as if it had been: `actions:` in the
  # wrong shape silently empties every lookup that reads it.
  jq -e 'has("actions") | not' >/dev/null <<<"$CFG" \
    || jq -e '.actions | type == "object"' >/dev/null <<<"$CFG" \
    || die "actions: must be a mapping of action name to not-applicable, human, or a module"
}

# The module list, project-wide and per app. `extends` is the current key; the retired
# composition:/implementation:/practices: shape is read for one minor, with a warning.
resolve_extends() {
  SCOPES=$(jq -c '
    def app_list: (.apps // []) | map({
      name: .name, path: (.path // ""),
      extends: (.extends // ([.implementation] + (.practices // []) | map(select(. != null))))
    });
    { project: (.extends // ((.composition // {}) | to_entries | map(select(.value != null) | .value)))
    , apps: app_list
    , overrides: (.actions // {}) }' <<<"$CFG")

  if ! jq -e 'has("extends")' >/dev/null <<<"$CFG"; then
    note "warning: .scrumia/config.yaml still uses the retired composition:/practices: keys — read for now, migrate to extends:"
  fi
}

# Ask one module to describe itself. Prints the manifest and returns a status; it never
# calls die, because a command substitution runs in a subshell where exit stops nothing —
# which is how a build that could reach no module at all still wrote a clean, empty tree
# and exited 0. The caller checks the status and stops in the parent shell.
manifest_of() {
  local m=$1 out
  if [ -n "${SCRUMIA_MODULE_DIR:-}" ] && [ -d "$SCRUMIA_MODULE_DIR/$m" ]; then
    if [ -f "$SCRUMIA_MODULE_DIR/$m/composition.json" ]; then
      jq --arg root "$(cd "$SCRUMIA_MODULE_DIR/$m" && pwd)" '. + {root: $root}' \
        "$SCRUMIA_MODULE_DIR/$m/composition.json" 2>/dev/null && return 0
      note "$m: composition.json is not valid JSON"
      return 1
    fi
    printf '{"module":%s,"absent":true}\n' "$(jq -Rn --arg m "$m" '$m')"
    return 0
  fi
  if ! command -v "$m-manifest" >/dev/null 2>&1; then
    note "$m is named in extends but $m-manifest is not on PATH — enable the plugin, then restart the session (a plugin's bin/ goes on PATH at session start). A missing name is never read as 'this module contributes nothing'."
    return 1
  fi
  if ! out=$("$m-manifest" 2>/dev/null); then
    # Reached, and unable to answer: that is the named degradation, not a stop.
    printf '{"module":%s,"absent":true}\n' "$(jq -Rn --arg m "$m" '$m')"
    return 0
  fi
  if ! jq -e 'type == "object"' >/dev/null 2>&1 <<<"$out"; then
    note "$m-manifest did not print a JSON object"
    return 1
  fi
  printf '%s\n' "$out"
}

collect_manifests() {
  local names m one failed=0
  names=$(jq -r '[.project[], (.apps[].extends[])] + ["scrumia-core"] | unique[]' <<<"$SCOPES")
  MANIFESTS="[]"
  for m in $names; do
    if one=$(manifest_of "$m"); then
      MANIFESTS=$(jq -c --argjson one "$one" '. + [$one]' <<<"$MANIFESTS")
    else
      failed=$((failed + 1))
    fi
  done
  [ "$failed" -eq 0 ] || die "$failed module(s) named in extends could not be reached — nothing was written, because an empty assembly reads as 'no rules apply'"
}

# Only the project's own cheap inputs. Covering the modules' manifests would make `load`
# run every one of them to verify — per-call resolution, and most of build's work — and a
# refusal that costs more than a recompute does not survive its first complaint.
inputs_digest() {
  { cat "$CONFIG"
    find .scrumia/impl .scrumia/practices .scrumia/rules -type f 2>/dev/null | LC_ALL=C sort | while read -r f; do
      printf '%s\n' "$f"; cat "$f"
    done
  } | { shasum -a 256 2>/dev/null || sha256sum; } | cut -d' ' -f1
}

render() {
  jq -j --argjson scopes "$SCOPES" --argjson manifests "$MANIFESTS" \
        --arg digest "$1" --arg out "$OUT" -f "$PROGRAM" "$VOCAB"
}

write_tree() {
  local dest=$1 path body
  rm -rf "$dest"
  # Piped, never captured: a bash variable cannot hold the NUL that delimits these records.
  while IFS= read -r -d '' path && IFS= read -r -d '' body; do
    path="$dest/${path#"$OUT"/}"
    mkdir -p "$(dirname "$path")"
    printf '%s' "$body" > "$path"
  done < <(render "$2")
}

cmd_build() {
  load_config; resolve_extends; collect_manifests
  local d; d=$(inputs_digest)
  write_tree "$OUT" "$d"
  local n; n=$(find "$OUT" -name '*.md' | wc -l | tr -d ' ')
  note "wrote $n file(s) under $OUT (digest ${d:0:12})"
  jq -r '.[] | select(.absent == true) | "  " + .module + ": reached, ships no composition.json — contributes nothing"' <<<"$MANIFESTS" >&2
}

cmd_load() {
  [ $# -eq 1 ] || usage
  local a=$1
  local f="$OUT/$a.md"
  [ -f "$f" ] || die "no assembly for $a — run 'scrumia-assemble build', or check the action name"
  load_config
  local want have
  want=$(inputs_digest)
  have=$(sed -n 's/^Inputs digest: `\([0-9a-f]*\)`$/\1/p' "$OUT/index.md" 2>/dev/null | head -1)
  [ "$want" = "$have" ] || die "$OUT is stale (config digest ${want:0:12}, built from ${have:0:12}) — run 'scrumia-assemble build'"
  # Only here does a path this machine can open appear: the committed file holds none.
  resolve_extends; collect_manifests
  local script m root
  script=""
  while IFS=$'\t' read -r m root; do
    script="$script;s|\`$m/|\`$root/|g"
  done < <(jq -r '.[] | select(.root) | .module + "\t" + .root' <<<"$MANIFESTS")
  sed "${script#;}" "$f"
}

cmd_check() {
  load_config; resolve_extends; collect_manifests
  local d tmp; d=$(inputs_digest); tmp=$(mktemp -d) || die "cannot create a temp dir"
  # shellcheck disable=SC2064
  trap "rm -rf '$tmp'" EXIT
  write_tree "$tmp/assemblies" "$d"
  if ! diff -ru "$OUT" "$tmp/assemblies" >/dev/null 2>&1; then
    diff -ru "$OUT" "$tmp/assemblies" >&2 || true
    die "$OUT has drifted from the composition — run 'scrumia-assemble build' and commit the result"
  fi
  note "$OUT is up to date"
}

[ $# -ge 1 ] || usage
case "$1" in
  build) shift; [ $# -eq 0 ] || usage; cmd_build ;;
  load)  shift; cmd_load "$@" ;;
  check) shift; [ $# -eq 0 ] || usage; cmd_check ;;
  *)     usage ;;
esac
