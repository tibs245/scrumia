#!/usr/bin/env bash
# ScrumIA — prints the directives that extend one register, for this project.
#
# A register is a named extension point a main skill opens. Any installed module may
# contribute directives to it by shipping `extends.json` at its own root. Nothing in that
# file names a consumer: a module declares what it offers, never who takes it.
#
# This tool reads the project's composition, collects the contributions of the modules
# the project actually runs, and prints one table. It computes at call time and writes
# nothing — there is no artefact that can go stale, and none to commit.
#
#   scrumia-extends <register> [--app <name>|--path <file>] [--json]
#   scrumia-extends --list
#   scrumia-extends --modules
#   scrumia-extends --check
#   scrumia-extends --settings [<source>:<module>] [--legacy <nest>[=<key>]]

set -uo pipefail

SELF=$(basename "$0")
CONFIG="${SCRUMIA_CONFIG:-.scrumia/config.yaml}"

# Everything the project keeps under .scrumia/ is found beside the configuration, never
# beside the working directory: pointing $SCRUMIA_CONFIG at another project must take that
# project's modules and overrides with it, or the two disagree about which is being read.
SCRUMIA_DIR=$(dirname -- "$CONFIG")
# Layer 3 of the settings cascade. Never committed, so it is absent far more often than
# present, and its absence is the ordinary case rather than a missing prerequisite.
CONFIG_LOCAL="${SCRUMIA_CONFIG_LOCAL:-$SCRUMIA_DIR/config.local.yaml}"
LOCAL_EXTENDS="${SCRUMIA_LOCAL_EXTENDS:-$SCRUMIA_DIR/extends.json}"
LOCAL_MODULES="$SCRUMIA_DIR/modules"
ENV_LOCAL="$SCRUMIA_DIR/.env.local"

die() { echo "$SELF: $1" >&2; exit 1; }
note() { echo "$SELF: $1" >&2; }

usage() {
  cat >&2 <<'EOF'
scrumia-extends <register>              # the directives that extend this register
scrumia-extends <register> --app <name> # …including the modules that app extends
scrumia-extends <register> --path <f>   # …resolving the app from a file's path
scrumia-extends <register> --json       # the same rows, unrendered
scrumia-extends --list                  # every register opened here, and what reaches it
scrumia-extends --modules [--json]      # every declared module, and where it resolved from
scrumia-extends --check                 # declared dependencies that are not met
scrumia-extends --settings [<key>]      # a module's configuration, the cascade applied
scrumia-extends --settings <key> --legacy <nest>[=<key>]
                                        # …reading the nest under `settings:` this module's
                                        # configuration used to sit in, as the key it is
                                        # now written under. Repeatable; a nest no layer
                                        # carries resolves clean.

A project declares the modules it runs under `modules:`, a mapping keyed
<source>:<module> — <owner>/<repo> for a marketplace, `shared`, or `local`. A bare name
is not a declaration and resolves to nothing. The retired `extends:` list and the older
`composition:`/`practices:` keys are still read, with a warning.

Each source is looked for in its own place, all three in one pass:

  <owner>/<repo>  every "…/bin" entry of $PATH whose parent is a plugin root — the
                  harness puts one there for every enabled plugin. $SCRUMIA_MODULE_DIR
                  stands in for this tier with a directory of <module>/ checkouts, for
                  this repository and for CI, where no harness is running.
  shared          $SCRUMIA_SHARED_DIR/<module>/, the variable read from .scrumia/.env.local
                  (KEY=value, never committed) unless the environment already carries it.
  local           .scrumia/modules/<module>/, beside the configuration that declares it.

A declaration no root answers is a declared absence. One that two distinct roots answer
is a conflict, named with both and bound to neither; --check exits non-zero on it. Only a
bare name from the retired list can be answered in more than one place at once: there the
narrowest wins and says so, so promoting a module never disables it.

Reads $SCRUMIA_CONFIG (default .scrumia/config.yaml), $SCRUMIA_CONFIG_LOCAL (default
.scrumia/config.local.yaml) and each module's own extends.json, registers.json and
dependencies.jsonl. Writes nothing, anywhere.
EOF
  exit 2
}

command -v jq >/dev/null 2>&1 || die "jq not found"

# ---------------------------------------------------------------- the composition

# Same loader as scrumia-board, scrumia-pick-model and compose-status.sh: one of the two
# YAML readers the machine already has, never a third dependency.
yaml_to_json() {
  if command -v yq >/dev/null 2>&1; then
    yq -o=json '.' "$1" 2>/dev/null
  else
    python3 -c 'import sys,yaml,json; json.dump(yaml.safe_load(open(sys.argv[1])) or {}, sys.stdout)' "$1" 2>/dev/null
  fi
}

load_config() {
  [ -f "$CONFIG" ] || die "no $CONFIG — run /scrumia-core:scrumia-init first"
  # Checked here rather than inside the reader: a `die` in a command substitution kills
  # the subshell only, and the caller then reports the wrong thing.
  command -v yq >/dev/null 2>&1 || python3 -c 'import yaml' >/dev/null 2>&1 ||
    die "need yq or python3+PyYAML to read $CONFIG"
  CFG=$(yaml_to_json "$CONFIG")
  [ -n "${CFG:-}" ] || die "$CONFIG is empty or not valid YAML"

  CFG_LOCAL='{}'
  if [ -f "$CONFIG_LOCAL" ]; then
    CFG_LOCAL=$(yaml_to_json "$CONFIG_LOCAL")
    jq -e 'type == "object"' >/dev/null 2>&1 <<<"${CFG_LOCAL:-}" || {
      note "$CONFIG_LOCAL is empty or not a mapping — ignored"; CFG_LOCAL='{}'; }
  fi

  # Three shapes have existed, and the precedence between them is fixed so that a
  # half-migrated file cannot resolve to nothing: a config carrying `modules:` read by a
  # tool testing only for `extends:` yields zero modules, every table renders empty, and
  # an empty table is an answer under BR-1 — so nothing would fail.
  SHAPE=modules; KEY_READ=modules
  if ! jq -e 'has("modules")' >/dev/null <<<"$CFG"; then
    if jq -e 'has("extends")' >/dev/null <<<"$CFG"; then
      SHAPE=extends; KEY_READ=extends
      note "warning: $CONFIG declares its modules under the retired 'extends:' — read for one more minor, migrate to 'modules:', keyed <source>:<module> (ADR-0021)"
    elif jq -e 'has("composition") or has("practices")' >/dev/null <<<"$CFG"; then
      SHAPE=legacy; KEY_READ=composition
      note "warning: $CONFIG still uses the retired composition:/practices: keys — read for now, migrate to modules:"
    else
      SHAPE=none; KEY_READ=modules
      note "warning: $CONFIG declares no 'modules:' — this composition is empty, so every register renders empty"
    fi
  fi

  # A declaration is its key, split at the last colon: everything before it is the source
  # (the location the module comes from), everything after it the module's own name. A key
  # with no colon carries no source, and an entry from one of the retired list shapes is
  # marked `legacy` — it predates the grammar, so it is matched by name and not reported.
  SCOPES=$(jq -c --arg shape "$SHAPE" '
    def parse_key:
      if test(":") then { key: ., source: sub(":[^:]*$"; ""), module: sub("^.*:"; "") }
      else { key: ., source: "", module: . } end;
    def from_mapping:
      to_entries | map((.key | parse_key) + { params: ((.value // {}).params // {}), legacy: false });
    def from_list: map(parse_key + { params: {}, legacy: true });
    def app_modules:
      if has("modules") then (.modules // {} | from_mapping)
      elif has("extends") then (.extends // [] | from_list)
      else ([.implementation] + (.practices // []) | map(select(. != null)) | from_list) end;
    { shape: $shape
    , settings: (.settings // {})
    , project: ( if $shape == "modules" then (.modules // {} | from_mapping)
                 elif $shape == "extends" then (.extends // [] | from_list)
                 elif $shape == "legacy" then
                   ((.composition // {}) | to_entries | map(select(.value != null) | .value) | from_list)
                 else [] end )
    , apps: ((.apps // []) | map({ name: .name, path: (.path // ""), modules: app_modules })) }' <<<"$CFG")

  # A key the grammar does not admit would make the file mean whatever happens to be
  # installed, which is the failure the qualified source removes — so it is named and
  # resolves to nothing, rather than matched against whichever module of that name a
  # machine happens to carry. BR-13 enumerates the three sources; a fourth is a typo.
  if [ "$SHAPE" = modules ]; then
    while IFS= read -r k; do
      [ -n "$k" ] || continue
      note "'$k' is not a declaration: a module is keyed <source>:<module> — <owner>/<repo>, 'shared' or 'local' (ADR-0021). Nothing resolves for it."
    done < <(jq -r '[.project[], .apps[].modules[]]
      | map(select(.source == "" or .module == ""
                   or (.source != "shared" and .source != "local"
                       and (.source | test("^[^/]+/[^/]+$") | not))))
      | .[].key' <<<"$SCOPES")
  fi

  # `modules:` written with nothing under it resolves to zero modules, and a register
  # with no contributions is an answer under BR-1 — so without this the emptiest possible
  # composition is the one that looks most like a correct run.
  EMPTY_COMPOSITION=no
  if jq -e '[.project[], .apps[].modules[]] | length == 0' >/dev/null <<<"$SCOPES"; then
    EMPTY_COMPOSITION=yes
    [ "$SHAPE" = none ] ||
      note "warning: $CONFIG declares no module under '$KEY_READ:' — this composition is empty, so every register renders empty"
  fi
}

# Which app a file belongs to — the longest declared path that prefixes it, so a nested
# app wins over the repository-wide one it sits inside.
app_of_path() {
  # `.path` is bound before the startswith: inside `$p | startswith(…)` the argument is
  # evaluated with `.` set to $p, so an unbound `.path` there indexes the string.
  jq -r --arg p "$1" '
    [.apps[] | . as $a | select($a.path != "" and ($p == $a.path or ($p | startswith($a.path + "/"))))]
    | sort_by(.path | length) | last | .name // ""' <<<"$SCOPES"
}

# ---------------------------------------------------------------- the modules

# One <module>/ per entry of a directory of checkouts, and no deeper. A tree walked to
# find modules would adopt one by having it copied into it, which is the opposite of a
# composition that declares what it runs. The path is physical — links resolved — because
# that, and not the name, is what says two routes reached one module.
roots_under() {
  local loc=$1 dir=$2 d
  [ -n "$dir" ] && [ -d "$dir" ] || return 0
  for d in "$dir"/*/; do
    [ -d "$d" ] || continue
    [ -f "${d}.claude-plugin/plugin.json" ] || continue
    printf '%s\t%s\n' "$loc" "$(cd -- "$d" && pwd -P)"
  done
}

# The per-machine half of a `shared` declaration, and nothing else: a `KEY=value` file,
# never committed. Read as data, never sourced — a machine's file that a tool executes is
# a machine's file that can do anything. An already-set variable wins, so one run can be
# pointed elsewhere without editing a machine's state (local-extension BR-6).
load_env_local() {
  local line key value
  [ -f "$ENV_LOCAL" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}
    key=${line%%=*}; value=${line#*=}
    [ "$key" != "$line" ] || continue
    # The four habits that would otherwise turn a correct file into an empty tier:
    # `export`, whitespace around either half, and quotes. Everything else about the
    # value is left alone — a path with a space needs no quoting, since nothing splits it.
    key=${key#"${key%%[![:space:]]*}"}; key=${key%"${key##*[![:space:]]}"}
    key=${key#export }; key=${key#"${key%%[![:space:]]*}"}
    value=${value#"${value%%[![:space:]]*}"}; value=${value%"${value##*[![:space:]]}"}
    value=${value#\"}; value=${value%\"}; value=${value#\'}; value=${value%\'}
    [ "$key" = SCRUMIA_SHARED_DIR ] || continue
    [ -n "${SCRUMIA_SHARED_DIR:-}" ] || SCRUMIA_SHARED_DIR=$value
  done < "$ENV_LOCAL"

  # The file exists, so someone wrote it meaning something. Read as nothing, it takes the
  # whole `shared` tier with it and every table just renders shorter — the silent failure
  # this tool refuses everywhere else it reads a file (see read_json below).
  if [ -z "${SCRUMIA_SHARED_DIR:-}" ]; then
    note "$ENV_LOCAL sets no SCRUMIA_SHARED_DIR — one line, KEY=value, and nothing keyed 'shared:' resolves until it does"
  elif [ ! -d "$SCRUMIA_SHARED_DIR" ]; then
    note "SCRUMIA_SHARED_DIR is '$SCRUMIA_SHARED_DIR', which is not a directory on this machine — every module keyed 'shared:' is a declared absence"
  fi
}

# Three tiers, one pass, each root tagged with the tier it came from — never one tier
# instead of another, because a fallback makes the answer depend on what is missing.
#
# The marketplace tier reads the roots back out of PATH: the harness prepends
# <pluginRoot>/bin to it for every enabled plugin, with the install path — version segment
# included — already resolved (ADR-0018). That is what lets an extension be a data file and
# nothing else: no module has to publish an executable just to be readable, and no path
# into a sibling is ever written. The other two are plain directories, stated in
# features/business/local-extension/'s tech.md.
discover_roots() {
  local dir loc root name src
  load_env_local
  ROOTS=$(
    {
      if [ -n "${SCRUMIA_MODULE_DIR:-}" ]; then
        roots_under marketplace "$SCRUMIA_MODULE_DIR"
      else
        # No `case` here: bash 3.2 mis-parses a pattern's `)` inside a command
        # substitution, and macOS still ships 3.2 as /bin/bash.
        while IFS= read -r dir; do
          root=${dir%/bin}
          [ "$root" != "$dir" ] || continue
          [ -f "$root/.claude-plugin/plugin.json" ] || continue
          printf 'marketplace\t%s\n' "$(cd -- "$root" && pwd -P)"
        done < <(printf '%s\n' "$PATH" | tr ':' '\n')
      fi
      roots_under shared "${SCRUMIA_SHARED_DIR:-}"
      roots_under local "$LOCAL_MODULES"
    } | awk '!seen[$0]++'
  )

  MODULES="[]"
  while IFS=$'\t' read -r loc root; do
    [ -n "$root" ] || continue
    name=$(jq -r '.name // ""' "$root/.claude-plugin/plugin.json" 2>/dev/null)
    [ -n "$name" ] || name=$(basename "$root")
    # The module's own claim about where it came from, normalised to owner/repo. It is
    # what a marketplace key and a caller's qualified dependency are checked against; a
    # module that declares none makes that check unverifiable rather than failed. It says
    # nothing about `shared` or `local`, which a manifest cannot know it is in.
    src=$(jq -r '(.repository // .homepage // "")
      | sub("^[a-z+]+://[^/]+/"; "") | sub("\\.git$"; "") | sub("/$"; "")' \
      "$root/.claude-plugin/plugin.json" 2>/dev/null)
    MODULES=$(jq -c --arg m "$name" --arg r "$root" --arg s "$src" --arg l "$loc" \
      --slurpfile ex <(read_json "$root/extends.json") \
      --slurpfile rg <(read_json "$root/registers.json") \
      --slurpfile dp <(read_jsonl "$root/dependencies.jsonl") \
      '. + [{module: $m, root: $r, location: $l, source: $s, extends: $ex[0], registers: $rg[0], runs: $dp[0]}]' \
      <<<"$MODULES")
  done <<<"$ROOTS"

  # The project is an extension of itself: .scrumia/extends.json carries the rows a
  # project adds without forking a module, and it outranks every module (ADR-0019's
  # "the project override beats both", kept as a scope rather than as a self-ranking).
  if [ -f "$LOCAL_EXTENDS" ]; then
    MODULES=$(jq -c --slurpfile ex <(read_json "$LOCAL_EXTENDS") \
      '. + [{module: "(this project)", root: ".", location: "project", source: "",
             extends: $ex[0], registers: {}, runs: []}]' <<<"$MODULES")
  fi
}

# One record per line, collected into an array. A dependency is a bare name today, so a
# line is a JSON string; an object with a `run` key is accepted too, so a second field can
# arrive without the format changing under every module at once.
read_jsonl() {
  if [ -f "$1" ]; then
    if ! jq -se '[.[] | if type == "string" then . elif type == "object" then (.run // empty) else empty end]' "$1" 2>/dev/null; then
      note "$1 is not one JSON record per line — ignored"; echo '[]'
    fi
  else
    echo '[]'
  fi
}

# A malformed data file is reported, never read as "this module contributes nothing":
# silence is exactly how a typo in an extension ships green.
read_json() {
  if [ -f "$1" ]; then
    if jq -e 'type == "object"' "$1" >/dev/null 2>&1; then cat "$1"; else
      note "$1 is not a JSON object — ignored"; echo '{}'
    fi
  else
    echo '{}'
  fi
}

# ---------------------------------------------------------------- binding

# Every jq below that turns declarations into roots starts from this. Written once and
# passed in, because a binding rule applied in two places will eventually be two rules,
# and the second one is always the lenient one.
#
# A key binds within the tier its source names, and nowhere else: a marketplace key wants
# the repository the manifest claims, `shared:` and `local:` want the name inside their own
# directory — a manifest cannot know which of those it was checked out into. A bare name
# from the retired `extends:` list predates the grammar, so it carries no tier and binds in
# any, which is the only case where more than one tier can answer one declaration.
#
# `local-extension` BR-7's identity test is the physical root: two routes to one directory
# are one module. Where several tiers answer a bare name, the narrowest wins and says so —
# a shadow, used and reported (BR-7). The order is written out rather than inherited from
# discovery, because a label nobody stated is a label that moves when the code is reordered.
BIND_DEFS='
  def tier_rank: if . == "local" then 0 elif . == "shared" then 1 else 2 end;
  def binds($d): .module == $d.module
    and ( if $d.legacy then true
          elif $d.source == "local" or $d.source == "shared" then .location == $d.source
          elif $d.source == "" then false
          else .location == "marketplace" and .source != "" and .source == $d.source end );
  def bound($decls; $mods): [ $decls[] | . as $d
    | (.roots = ([ $mods[] | select(binds($d)) ]
                 | group_by(.root) | map(min_by(.location | tier_rank))
                 | sort_by(.location | tier_rank)))
    | .state = ( if (.roots | length) == 0 then "absent"
                 elif (.roots | length) == 1 then "resolved"
                 elif $d.legacy and ([.roots[].location] | unique | length) == (.roots | length)
                   then "shadow"
                 else "conflict" end ) ];
  # A shadow binds, a conflict does not. Everything downstream reads this and never .state.
  def usable($decls; $mods):
    [ bound($decls; $mods)[] | select(.state == "resolved" or .state == "shadow") ];
'

# ---------------------------------------------------------------- the rows

# Scope decides order and precedence, and it comes from the project's composition, never
# from a module ranking itself: local > the app's own modules > the project-wide ones.
# That is ADR-0010's "specific beats generic, the project override beats both", expressed
# where the project can see it.
rows_for() {
  jq -c --arg reg "$1" --arg app "${2:-}" --argjson scopes "$SCOPES" "$BIND_DEFS"'
    . as $mods
    | ([$scopes.apps[] | select(.name == $app) | .modules] | first // []) as $appmods
    | usable($appmods; $mods) as $app_bound
    | ([$app_bound[].roots[0].root] | map({(.): true}) | add // {}) as $taken
    | [ $app_bound[] | {scope: 1, decl: ., mod: .roots[0]} ]
      + [ usable(($scopes.project // []); $mods)[]
          | select($taken[.roots[0].root] | not) | {scope: 2, decl: ., mod: .roots[0]} ]
      + [ $mods[] | select(.module == "(this project)") | {scope: 0, decl: {}, mod: .} ]
    | [ .[]
        | . as $b
        | ($b.mod.extends[$reg] // [])[]
        | { scope: $b.scope
          , scope_name: (["project-local", "app", "project-wide"][$b.scope])
          , module: $b.mod.module
          , declared_as: ($b.decl.key // $b.mod.module)
          , source: ($b.decl.source // "")
          , location: $b.mod.location
          , root: $b.mod.root
          , name: (.name // "(unnamed)")
          , type: (.type // "norm")
          , when: (.when // "required")
          , summary: (.summary // "")
          , read: (.read // "") } ]
    | sort_by([.scope, (if .when == "required" then 0 else 1 end), .module, .name])' <<<"$MODULES"
}

# Every declaration this project makes, with what it bound to. One list, so the register
# tables, --modules and --check cannot disagree about what resolved.
bindings() {
  jq -c --argjson scopes "$SCOPES" "$BIND_DEFS"'
    # An absent declaration still states where it would have come from — that is the whole
    # content of a declared absence (BR-8). A bare name from the retired list states none,
    # which is what the grammar replaced it for.
    def tier: if . == "local" or . == "shared" then . else "marketplace" end;
    . as $mods
    | [ bound(($scopes.project // []); $mods)[] | . + {scope: "project-wide"} ]
      + [ $scopes.apps[] | .name as $a | bound(.modules; $mods)[] | . + {scope: $a} ]
    # A conflict resolved nowhere, so it is credited with nowhere: naming the narrowest of
    # the roots it refused to pick between would read as the one it picked.
    | map({ key, module, source, scope, state
          , location: ( if .state == "resolved" or .state == "shadow" then .roots[0].location
                        elif .state == "conflict" then "—"
                        elif .legacy then "any"
                        elif .source == "" then "(none)"
                        else (.source | tier) end )
          , roots: [.roots[] | {location, root}] })' <<<"$MODULES"
}

# One root per module name, for every check that reasons about identity rather than about
# directives: which module opens a register, which publishes a name. Two roots wearing one
# name are one module to those questions, and the union is what made that reachable — left
# alone, a checkout beside its published copy reports the register as opened twice, by
# itself. Where a declaration picked a root, that one; otherwise the first discovered, since
# nothing the project said distinguishes them.
resolve_identity() {
  local bound
  bound=$(jq -c --argjson scopes "$SCOPES" "$BIND_DEFS"'. as $m
    | [ usable(($scopes.project // []); $m)[], ($scopes.apps[] | usable(.modules; $m)[]) ]
    | [.[].roots[0].root] | unique' <<<"$MODULES")
  CHECKED=$(jq -c --argjson bound "$bound" '
    ([$bound[] | {(.): true}] | add // {}) as $b
    | group_by(.module) | map((map(select($b[.root])) | first) // .[0])' <<<"$MODULES")
}

# A conflict is loud wherever it is reached, and fatal only at --check: a shortened table
# with no word said is the silent failure BR-9 exists to end, and a whole session stopped
# by a module the task never needed is the other way to get it wrong. A shadow is used, so
# it is only ever said — never counted as a failure.
conflict_lines() {
  jq -r '.[] | select(.state == "conflict")
    | "`\(.key)` is answered by \(.roots | length) different modules — "
      + ([.roots[] | .location + " " + .root] | join(", "))
      + " — so it binds neither and contributes no directive. Nothing picks between them."' \
    <<<"$1" | awk 'NF && !seen[$0]++'
}

shadow_lines() {
  jq -r '.[] | select(.state == "shadow")
    | "`\(.key)` names no location, and \(.roots | length) answer it: "
      + ([.roots[] | .location + " " + .root] | join(", "))
      + ". The narrowest is used — \(.roots[0].location). Key it <source>:<module> to say so."' \
    <<<"$1" | awk 'NF && !seen[$0]++'
}

render_table() {
  local reg=$1 rows=$2 app=$3
  local n mods
  n=$(jq 'length' <<<"$rows")
  mods=$(jq -r '[.[].module] | unique | length' <<<"$rows")

  printf '# %s — %s directive(s) from %s module(s)%s\n\n' "$reg" "$n" "$mods" \
    "$( [ -n "$app" ] && printf ', app `%s`' "$app" )"

  if [ "$n" -eq 0 ]; then
    # An empty table means two different things, and only one of them is fine.
    if [ "${EMPTY_COMPOSITION:-no}" = yes ]; then
      printf 'This project runs no module at all: `%s` in %s declares none.\n' "$KEY_READ" "$CONFIG"
      printf 'Every register renders empty until one is declared — so this table says\n'
      printf 'nothing about `%s` itself.\n' "$reg"
    else
      printf 'Nothing extends `%s` in this composition. That is an answer, not a failure:\n' "$reg"
      printf 'the register is open and no module the project runs contributes to it.\n'
    fi
    return
  fi

  cat <<'EOF'
Take what the task needs. `required` rows apply to every unit of work in scope;
`optional` rows are offered, and you decide. This table does not arbitrate: two rows
that contradict each other are both printed, because a generator cannot read English.

EOF
  printf '| Name | Type | Use | What it says | Read |\n|---|---|---|---|---|\n'
  jq -r '.[] | "| " + .name + " | " + .type + " | " + .when + " | " + .summary + " | `"
             + (if .read == "" then "—" else (.root + "/" + .read) end) + "` |"' <<<"$rows"

  printf '\nOrder is computed, never authored — project-local rows first, then the ones the\n'
  printf 'app extends, then the project-wide ones; `required` before `optional` within a tier.\n'
}

# ---------------------------------------------------------------- commands

cmd_register() {
  local reg=$1 app=$2 as_json=$3 rows all line
  rows=$(rows_for "$reg" "$app")

  if ! jq -e --arg r "$reg" 'any(.[]; .registers[$r] != null)' >/dev/null <<<"$CHECKED"; then
    note "no installed module opens the register '$reg' — run 'scrumia-extends --list' for the ones that exist"
  fi

  # Said on every table, not only on --modules: a table shortened by a conflict is
  # indistinguishable from a correct one, and this is the only place it can be said.
  all=$(bindings)
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    note "$line"
  done < <(conflict_lines "$all"; shadow_lines "$all")

  if [ "$as_json" = yes ]; then jq '.' <<<"$rows"; else render_table "$reg" "$rows" "$app"; fi
}

# AC-3's surface. compose-status.sh prints the declarations as written — a different claim,
# needing no location, and its stdout is a versioned fixture that must not depend on which
# machine ran it. This one resolves, so this one reports where each module came from.
cmd_modules() {
  local as_json=$1 all line
  all=$(bindings)

  if [ "$as_json" = yes ]; then jq '.' <<<"$all"; return; fi

  printf '# modules — %s declared, %s resolved\n\n' \
    "$(jq 'length' <<<"$all")" "$(jq '[.[] | select(.state == "resolved")] | length' <<<"$all")"

  if [ "$(jq 'length' <<<"$all")" -eq 0 ]; then
    printf 'This project declares no module: `%s` in %s is empty.\n' "$KEY_READ" "$CONFIG"
    return
  fi

  printf '| Declared as | Scope | Location | State | Resolved to |\n|---|---|---|---|---|\n'
  jq -r '.[] | "| `" + .key + "` | " + .scope + " | " + .location + " | " + .state + " | "
             + (if (.roots | length) == 0 then "—"
                else ([.roots[] | "`" + .root + "`"] | join(", ")) end) + " |"' <<<"$all"

  printf '\nA declaration nothing answers is an absence, not a failure: the module is not\n'
  printf 'reachable from here, every register renders without it, and the location above is\n'
  printf 'where it would come from.\n'

  while IFS= read -r line; do
    [ -n "$line" ] || continue
    note "$line"
  done < <(conflict_lines "$all"; shadow_lines "$all")
}

cmd_list() {
  jq -r --argjson scopes "$SCOPES" '
    . as $mods
    | [ $mods[] | .module as $m | (.registers // {}) | to_entries[]
        | { register: .key, opened_by: $m, skill: (.value.skill // "—"), purpose: (.value.purpose // "") } ]
    | . as $opened
    | ([ $mods[] | (.extends // {}) | keys[] ] | unique) as $extended
    | "| Register | Opened by | Main skill | Purpose | Modules extending it |",
      "|---|---|---|---|---|",
      ( ($opened | map(.register)) + $extended | unique | sort[] as $r
        | ($opened[] | select(.register == $r)) // {register: $r, opened_by: "— nobody —", skill: "—", purpose: ""}
        | . as $o
        | "| `" + $r + "` | " + $o.opened_by + " | " + $o.skill + " | " + $o.purpose + " | "
          + ([ $mods[] | select((.extends // {}) | has($r)) | .module ] | length | tostring) + " |" )
  ' <<<"$CHECKED"
}

# A module's configuration is three layers, each overriding the one before: `settings:`,
# which holds what is no module's; the module's own `params:`; and the per-machine local
# layer, which is never committed and overrides both in either shape it may use. The order
# is written here because an order only applied can invert without anything failing.
#
# Each layer is normalised to the current shape *before* the layers combine, so the merge
# order is the only thing left that can decide. Reconciled afterwards instead, the shape
# would decide where BR-14 says the layer does — and the layer it would discard is the
# per-machine one, which is never committed and so is never the one a migration carries
# forward (`modular-composition`'s tech.md, § *Which shape a module's own settings are read
# in*). What the retired nest is called is the asking module's to say, not this tool's:
# core naming another module's block is the reach into a sibling that ADR-0018 refuses.
cmd_settings() {
  local key=$1 app=$2 answer
  if [ -n "$key" ] &&
     ! jq -e --arg k "$key" 'any([.project[], .apps[].modules[]][]; .key == $k)' >/dev/null <<<"$SCOPES"; then
    note "no module is declared under '$key' in $CONFIG — resolving the layers that do not depend on it"
  fi

  # Said rather than assumed: without a mapping this answer is the cascade as written, and
  # a module still reading a retired nest resolves it somewhere this table does not show.
  # A caller that passes one is told nothing — the two agree, so there is nothing to warn.
  [ -n "$key" ] && [ "$LEGACY" = "[]" ] &&
    note "resolved with no retired-nest mapping: if this module still reads keys under a 'settings.<nest>' block, pass --legacy <nest> to resolve them where it reads them"

  # The provenance is derived from the layers that carried something, never from the
  # layers that exist: a line naming a layer that did not answer is worse than no line,
  # because it is the one output whose whole job is to make the cascade checkable.
  answer=$(jq -c -n --argjson s "$SCOPES" --argjson l "$CFG_LOCAL" --argjson legacy "$LEGACY" \
    --arg k "$key" --arg app "$app" --arg lf "$CONFIG_LOCAL" '
    def params_of($set): ($set | map(select(.key == $k and $k != "")) | first | .params) // {};

    # A key written bare is a key not yet migrated, and `*` propagates an explicit null —
    # so without this it erases the layer it defers to. Recursive, because the two shapes
    # put a module block at different depths and a depth is not a thing to hard-code.
    def strip: walk(if type == "object" then with_entries(select(.value != null)) else . end);

    # The retired nest of this layer, moved to where the current shape reads it. `getpath` is
    # given a key sequence, never a string spliced into this program: a path from the
    # command line is data.
    def hoist: . as $h
      | reduce $legacy[] as $m ({};
          (try ($h | getpath($m.path)) catch null) as $v
          | if ($v | type) != "object" then .
            elif $m.key == "" then . * $v
            else . * { ($m.key): $v } end);
    # Hoisted first, so the current shape still wins key by key inside one layer.
    def norm: strip | (hoist * .);
    # A layer of empty blocks and bare keys resolved to nothing, whatever it was written
    # with, so it did not answer and is not claimed. Arrays count: an empty list replaces
    # rather than merges, so writing one is an answer even though it holds no scalar.
    def carries: ([paths(scalars)] + [paths(arrays)]) | length > 0;

    (($s.settings // {}) | norm) as $base
    | (params_of($s.project) | norm) as $proj
    | (params_of([$s.apps[] | select(.name == $app) | .modules[]]) | norm) as $app_params
    | (($l.settings // {}) | norm) as $local_base
    | ((if $k == "" then {} else ((($l.modules // {})[$k] // {}).params // {}) end) | norm) as $local_params
    | { resolved: ($base * $proj * $app_params * $local_base * $local_params)
      , layers: [ (if ($base | carries) then "settings:" else empty end)
                , (if ($proj | carries) then "params: of " + $k else empty end)
                , (if ($app_params | carries) then "params: of " + $k + " in app " + $app else empty end)
                , (if (($local_base | carries) or ($local_params | carries)) then $lf else empty end) ] }')

  note "resolved from $(jq -r 'if (.layers | length) == 0 then "nothing: no layer carries a value"
                               else (.layers | join(", ")) end' <<<"$answer")"
  jq '.resolved' <<<"$answer"
}

# Prints "<module>\t<source>" for the discovered module that ships an executable of this
# name under its own bin/, and nothing when no discovered module does.
publisher_of() {
  local root
  while IFS=$'\t' read -r root mod src; do
    [ -n "$root" ] && [ -x "$root/bin/$1" ] && { printf '%s\t%s\n' "$mod" "$src"; return 0; }
  done < <(jq -r '.[] | select(.root != ".") | [.root, .module, .source] | @tsv' <<<"$CHECKED")
  return 1
}

cmd_check() {
  local failed=0 line all
  # The one surface a conflict is fatal at (local-extension BR-9). Everywhere else it is
  # reported and the composition carries on; here it is what it is — a declaration that
  # cannot be met, so nothing that depends on that module can be trusted to have run.
  all=$(bindings)
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    echo "$line" >&2
    failed=$((failed + 1))
  done < <(conflict_lines "$all")

  # A shadow is met, so it is said and not counted. Said here because this is the surface
  # someone runs when asking what is wrong, and it was the only one staying silent.
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    note "$line"
  done < <(shadow_lines "$all")

  # A `runs` entry is qualified — <source>:<name> — because PATH is one flat namespace
  # shared with every enabled plugin, so a bare name says which command, never whose.
  # What is *executed* stays the bare name: the qualification is a claim to check, not
  # something to invoke.
  while IFS=$'\t' read -r mod entry; do
    [ -n "$entry" ] || continue
    local want name found pub_mod pub_src
    want=${entry%:*}; name=${entry##*:}
    if [ "$want" = "$entry" ]; then
      want=""
      note "$mod declares running '$name' unqualified — name it <source>:<name>, since PATH is shared with every enabled plugin"
    fi

    # Under $SCRUMIA_MODULE_DIR no harness is running, so PATH proves nothing on its own:
    # a name is also met when a discovered module publishes it under its own bin/.
    found=$(publisher_of "$name") || found=""
    if [ -z "$found" ] && ! command -v "$name" >/dev/null 2>&1; then
      echo "$mod declares running '$name', which is neither on PATH nor published by an installed module — enable the module that publishes it, then restart the session" >&2
      failed=$((failed + 1))
      continue
    fi

    [ -n "$want" ] || continue
    IFS=$'\t' read -r pub_mod pub_src <<<"$found"
    if [ -z "$found" ]; then
      note "$mod runs '$name' from '$want': on PATH, published by no installed module — the source cannot be checked here"
    elif [ -z "$pub_src" ]; then
      note "$mod runs '$name' from '$want': published by $pub_mod, which declares no repository — the source cannot be checked"
    elif [ "$pub_src" != "$want" ]; then
      echo "$mod declares running '$want:$name', but the '$name' it would reach is published by $pub_mod, from '$pub_src' — a name on PATH is first-come, so this is a different command wearing the same name" >&2
      failed=$((failed + 1))
    fi
  done < <(jq -r '.[] | .module as $m | (.runs // [])[] | $m + "\t" + .' <<<"$CHECKED")

  # A contribution to a register nobody opens is inert — it will never be printed, and
  # nothing else would ever say so.
  while IFS=$'\t' read -r mod reg; do
    [ -n "$reg" ] || continue
    if ! jq -e --arg r "$reg" 'any(.[]; .registers[$r] != null)' >/dev/null <<<"$CHECKED"; then
      echo "$mod extends the register '$reg', which no installed module opens — those directives reach nothing" >&2
      failed=$((failed + 1))
    fi
  done < <(jq -r '.[] | .module as $m | (.extends // {}) | keys[] as $k | $m + "\t" + $k' <<<"$CHECKED")

  # Two modules opening one register leaves no way to say which main skill consumes it.
  # The tool does not pick; it reports and stops.
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    echo "$line" >&2
    failed=$((failed + 1))
  done < <(jq -r '
    [ .[] | .module as $m | (.registers // {}) | keys[] | {register: ., module: $m} ]
    | group_by(.register) | map(select(length > 1))[]
    | "the register `" + .[0].register + "` is opened by " + ([.[].module] | join(" and "))
      + " — nothing decides which main skill consumes it"' <<<"$CHECKED")

  if [ "$failed" -gt 0 ]; then
    die "$failed unmet dependency/dependencies"
  fi
  note "every declared dependency is met"
}

# ---------------------------------------------------------------- argument handling

[ $# -ge 1 ] || usage
REGISTER=""; APP=""; AS_JSON=no; MODE=register; MODULE_KEY=""; LEGACY="[]"
while [ $# -gt 0 ]; do
  case "$1" in
    --list)  MODE=list; shift ;;
    --modules) MODE=modules; shift ;;
    --check) MODE=check; shift ;;
    # The key is optional: without one, the answer is the base layer a module inherits
    # before any `params:` of its own.
    --settings) MODE=settings; shift
                if [ $# -ge 1 ]; then
                  # `-*` is the next option, not this one's argument.
                  [ "${1#-}" = "$1" ] && { MODULE_KEY=$1; shift; }
                fi ;;
    # `<path>` or `<path>=<key>`: where this module's configuration used to sit under
    # `settings:`, and the current-shape key it becomes. Split at the *last* `=` so a key
    # containing one is still addressable, and repeatable for a module with several.
    --legacy) [ $# -ge 2 ] || usage
              case "$2" in ""|=*) die "--legacy needs a path: --legacy <nest>[=<key>]" ;; esac
              LEGACY=$(jq -c --arg spec "$2" '
                ($spec | if test("=") then {p: sub("=[^=]*$"; ""), k: sub("^.*="; "")}
                         else {p: ., k: ""} end) as $m
                | . + [{path: ($m.p | split(".")), key: $m.k}]' <<<"$LEGACY") ||
                die "--legacy '$2' could not be parsed"
              shift 2 ;;
    --json)  AS_JSON=yes; shift ;;
    --app)   [ $# -ge 2 ] || usage; APP=$2; shift 2 ;;
    --path)  [ $# -ge 2 ] || usage; APP_PATH=$2; shift 2 ;;
    -h|--help) usage ;;
    -*)      die "unknown option: $1" ;;
    *)       [ -z "$REGISTER" ] || usage; REGISTER=$1; shift ;;
  esac
done

# Checked here, not at dispatch: the flags are order-independent, so this is the first
# point both are known — and an argument error must not cost a full discovery pass first.
[ "$LEGACY" = "[]" ] || [ "$MODE" = settings ] || die "--legacy applies to --settings only"

load_config
discover_roots
resolve_identity

if [ -n "${APP_PATH:-}" ]; then
  APP=$(app_of_path "$APP_PATH")
  [ -n "$APP" ] || note "no app in $CONFIG covers $APP_PATH — only the project-wide modules apply"
fi

case "$MODE" in
  list)     [ -z "$REGISTER" ] || usage; cmd_list ;;
  modules)  [ -z "$REGISTER" ] || usage; cmd_modules "$AS_JSON" ;;
  check)    [ -z "$REGISTER" ] || usage; cmd_check ;;
  settings) [ -z "$REGISTER" ] || usage; cmd_settings "$MODULE_KEY" "$APP" ;;
  *)        [ -n "$REGISTER" ] || usage; cmd_register "$REGISTER" "$APP" "$AS_JSON" ;;
esac
