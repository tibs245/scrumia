# BMAD reference clone, kept out of version control
.reference/

.DS_Store
node_modules/
__pycache__/
*.pyc
.worktrees/
# The harness places its own worktrees here; each is a checkout of this repo.
.claude/worktrees/

# check_run_horizon.py measures a page in place, so its scratch copy lands next to
# the real one — and site/ is what Pages publishes.
site/**/_probe.html

# The role-review fallback writes its prompt into the worktree, and a run must reach
# a clean `git status` before it spawns a role — so this must never be commit fodder.
review-prompt.txt

# A shared checkout lives on one machine, not in the repository: features/business/local-extension/
.scrumia/.env.local

# Per-machine settings overrides — layer 3 of the cascade: features/business/modular-composition/
.scrumia/config.local.yaml
